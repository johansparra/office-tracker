{"nodes": [{"id": "claude_claude_md", "label": "CLAUDE.md (gu\u00eda para Claude Code)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_script_load_order", "label": "Orden de carga de scripts cl\u00e1sicos con globals compartidos", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Development", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin build ni m\u00f3dulos: 17 scripts en js/ comparten variables globales; cada archivo solo usa a nivel superior lo definido antes. Un archivo nuevo se agrega a index.html y a la lista JS de sw.js."}, {"id": "claude_version_bump", "label": "Subir VERSION (sw.js) y APP_VER (config.js) juntos", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Development", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El SW trae HTML/JS/CSS network-first con cache:no-cache porque GitHub Pages env\u00eda max-age=600; APP_VER se muestra y se escribe en el log."}, {"id": "claude_global_state_s", "label": "Estado global S", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/State", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un \u00fanico objeto con data, evIds, pending, log, fs, rem, nonces...; persistido en localStorage ot-data-v2 esquema v:3 con migraci\u00f3n."}, {"id": "claude_quota_logic", "label": "L\u00f3gica de meta mensual (8 \u2212 semanas ajustadas)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Quota logic", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_change_flow", "label": "Flujo de cambio toggle \u2192 applyChange \u2192 schedulePush", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Change flow", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Espera UNDO_MS (5 s) para permitir Deshacer antes de subir a Calendar y a la hoja; flushPushes sube al ocultar la p\u00e1gina."}, {"id": "claude_sync_queue", "label": "Cola de sincronizaci\u00f3n enqueue() y gcal()", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Sync queue", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Una sola cadena de promesas serializa todo el trabajo con APIs de Google para que nunca haya dos sincronizaciones a la vez y alimenta el indicador de sync."}, {"id": "claude_calendar_sync", "label": "Sincronizaci\u00f3n con Google Calendar (OAuth GIS, calendario \u00fanico)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Calendar sync", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scopes m\u00ednimos: calendar.app.created m\u00e1s calendarlist.readonly (calendarList.list rechaza app.created solo) y drive.file; nunca crea calendario si fall\u00f3 la b\u00fasqueda; el de id menor gana."}, {"id": "claude_change_detection", "label": "Detecci\u00f3n de cambios (checkChanges 10 s / 60 s)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Change detection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consulta liviana (updatedMin + modifiedTime de Drive) y solo dispara syncAll si hay cambios; con Firebase solo revisa Calendar cada 60 s porque Firestore entrega los cambios entre dispositivos."}, {"id": "claude_firebase_realtime", "label": "Firebase tiempo real (Firestore fuente de verdad)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Firebase", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Docs de d\u00edas nunca se borran (tombstone type:null), gana el ts m\u00e1s nuevo; migraci\u00f3n espera firstFromServer() para no basarse en la cach\u00e9 vac\u00eda."}, {"id": "claude_history_spreadsheet", "label": "Hoja de historial append-only", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/History spreadsheet", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La hoja nunca se modifica: borrar en la app solo oculta, compartido v\u00eda pesta\u00f1a Ocultos y Firestore hidden; sin Firebase la hoja es el historial compartido (pullSheet)."}, {"id": "claude_reminders", "label": "Avisos en Calendar (10:00 y 16:30, HORIZON 21 d\u00edas)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/Reminders", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_deep_links", "label": "Deep links ?d=&r=&n= con nonce", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/Deep links", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_rendering", "label": "Renderizado completo desde S con innerHTML", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Rendering", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin framework; no cambiar TYPE_LBL porque sus emojis son t\u00edtulos de eventos que classify() vuelve a leer; animar solo transform/opacity."}, {"id": "claude_type_lbl_invariant", "label": "Invariante: no cambiar TYPE_LBL", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Rendering", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los emojis de TYPE_LBL son los t\u00edtulos de eventos en Calendar y classify() los parsea de vuelta."}], "edges": [{"source": "claude_claude_md", "target": "readm