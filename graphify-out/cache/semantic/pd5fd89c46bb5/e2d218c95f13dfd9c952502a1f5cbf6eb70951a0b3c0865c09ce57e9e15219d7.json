{"nodes": [{"id": "claude", "label": "CLAUDE.md (gu\u00eda para Claude Code)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_global_state_s", "label": "Estado global S", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/State", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un solo objeto S guarda data, evIds, pending, log, logOut/hidden/hideOut, rem/nonces/skip, fs, sheetId, account, legacy; persistido en localStorage 'ot-data-v2' con esquema v:3; load() migra formas viejas marcando todo como pendiente."}, {"id": "claude_localstorage_ot_data_v2", "label": "localStorage ot-data-v2 (esquema v:3)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/State", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Datos ilegibles se copian a ot-data-v2-danado en vez de perderse."}, {"id": "claude_change_flow", "label": "Flujo de cambio de d\u00eda (toggle \u2192 applyChange \u2192 schedulePush)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/Change flow", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_sync_queue", "label": "Cola de sincronizaci\u00f3n enqueue() + gcal()", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/Sync queue", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toda llamada a Google se serializa en una sola cadena de promesas para que nunca haya dos sincronizaciones a la vez y el indicador (S.busy, #topbar, step()) refleje el trabajo."}, {"id": "claude_change_detection", "label": "Detecci\u00f3n de cambios (checkChanges cada 10 s / 60 s)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/Change detection", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consultas livianas (updatedMin+showDeleted en Calendar, modifiedTime de Drive) y solo dispara syncAll() si algo cambi\u00f3; con Firebase baja a 60 s porque Firestore ya entrega los cambios entre dispositivos."}, {"id": "claude_deep_links", "label": "Enlaces profundos de avisos (?d&r&n&a)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/Deep links", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_rendering_innerhtml", "label": "Render completo con template strings en innerHTML", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Rendering", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin framework ni virtual DOM: render() reconstruye toda la UI desde S; cada tarjeta se dibuja aislada para que un fallo no deje la pantalla en blanco."}, {"id": "claude_motion_policy", "label": "Pol\u00edtica de movimiento (anim(), transform/opacity, reduced-motion)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Architecture/Rendering", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo se animan transform/opacity; anim() no hace nada con prefers-reduced-motion; hover solo dentro de @media (hover:hover) and (pointer:fine)."}, {"id": "claude_error_policy", "label": "Pol\u00edtica de errores: nunca tragar (reportar/seguro)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Development", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ning\u00fan catch vac\u00edo; reportar(where, err)/seguro(where, fn) en js/adaptadores/errores.js; officeTrackerErrores() en consola; una prueba lo exige."}, {"id": "claude_version_bump", "label": "Subir VERSION (sw.js) y APP_VER juntos al publicar", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Development", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "APP_VER se muestra en encabezado/pie y se escribe en el log; una prueba verifica que coincida con VERSION del service worker."}, {"id": "claude_service_worker_cache_strategy", "label": "Estrategia de cach\u00e9 del SW (network-first HTML/JS/CSS, cache-first \u00edconos)", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": "Development", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GitHub Pages env\u00eda max-age=600, as\u00ed que HTML/JS/CSS se piden con cache:'no-cache'; or\u00edgenes de Google y peticiones no-GET saltan el SW."}, {"id": "claude_reminder_title_patch", "label": "T\u00edtulo de aviso cambia con d\u00edas obligatorios (S.rem[k].t + PATCH)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Architecture/Quota logic", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_graphify_out", "label": "graphify-out (grafo de conocimiento)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": "Development", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude", "target": "readme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Overview", "weight": 1.0}, {"source": "claude", "target": "readme_firebase_guide_phases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Overview", "weight": 1.0}, {"source": "claude", "target": "readme_hexagonal_architecture", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": "Development", "weight": 1.0}, {"source": "