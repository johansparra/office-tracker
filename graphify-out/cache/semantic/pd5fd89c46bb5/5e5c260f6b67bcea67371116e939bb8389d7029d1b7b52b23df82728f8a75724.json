eeplink", "label": "readDeepLink()", "file_type": "code", "source_file": "index.html", "source_location": "L1322", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_cleanuplegacy", "label": "cleanupLegacy()", "file_type": "code", "source_file": "index.html", "source_location": "L1242", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_autherror", "label": "AuthError", "file_type": "code", "source_file": "index.html", "source_location": "L667", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_fbsignin", "label": "fbSignIn()", "file_type": "code", "source_file": "index.html", "source_location": "L1086", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_settoken", "label": "setToken()", "file_type": "code", "source_file": "index.html", "source_location": "L568", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_hastoken", "label": "hasToken()", "file_type": "code", "source_file": "index.html", "source_location": "L573", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_app_state_s", "label": "App state object S (data, evIds, pending, log, hidden)", "file_type": "concept", "source_file": "index.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single in-memory store persisted to localStorage by save()/load(); shared by all sync paths."}, {"id": "index_firestore_source_of_truth", "label": "Firestore as source of truth (realtime mode)", "file_type": "rationale", "source_file": "index.html", "source_location": "L1056", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With Firebase on, Firestore wins for days/history; Google Calendar becomes a copy, except events edited in Calendar after the last Firestore change are imported."}, {"id": "index_pending_wins_reconciliation", "label": "Pending-wins month reconciliation", "file_type": "rationale", "source_file": "index.html", "source_location": "L800", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without Firebase: local pending changes win; otherwise Calendar wins (create/move/rename/delete from Calendar app); duplicate events per day collapse to one."}, {"id": "index_serial_sync_queue", "label": "Serial Calendar job queue", "file_type": "rationale", "source_file": "index.html", "source_location": "L1204", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All Calendar/Sheet work runs one at a time on a promise chain; S.busy feeds the sync indicator."}, {"id": "index_undo_window", "label": "Undo window before push", "file_type": "rationale", "source_file": "index.html", "source_location": "L1263", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Changes are pushed only after UNDO_MS; pushDay skips days still in the undo timer."}, {"id": "index_sheet_audit_log", "label": "Google Sheet history audit log", "file_type": "concept", "source_file": "index.html", "source_location": "L902", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historial tab is an append-only audit log; deleted entries are hidden via an Ocultos tab rather than removed, and a deleted sheet is recreated automatically."}, {"id": "index_change_polling", "label": "Lightweight change polling", "file_type": "rationale", "source_file": "index.html", "source_location": "L1660", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polls Calendar updatedMin (10s, or 60s with Firebase) and Drive modifiedTime; triggers full syncAll only when something changed, plus 5-minute fallback full sync."}, {"id": "index_first_server_migration", "label": "First-server-snapshot migration", "file_type": "rationale", "source_file": "index.html", "source_location": "L1125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uploading local data missing in Firestore waits for the first non-cache snapshot so an empty cache on a new device does not overwrite newer data."}, {"id": "index_reminder_nonce_deeplink", "label": "Reminder deep link with nonce verification", "file_type": "concept", "source_file": "index.html", "source_location": "L841", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calendar reminder events at 10:00 and 16:30 contain a link ?d=&r=&n=; the nonce is verified when opening the notification sheet."}, {"id": "index_colombia_holidays", "label": "Colombian holiday calendar (Emiliani law, Easter-based)", "file_type": "concept", "source_file": "index.html", "source_location": "L468", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "index_office_attendance_goal", "label": "Monthly office attendance goal / mandatory days", "file_type": "concept", "source_file": "index.html", "source_location": "L502", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "index_syncall", "target": "index_enqueue", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": null, "weight": 1.0}, {"source": "index_syncall", "target": "index_ensurecalendar", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": null, "weight": 1.0}, {"source": "index_syncall", "target": "index_pullsheet", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "index.html", "source_location": null, "weight": 1.0}, {"source": "index_syncall", "target": "index_reconcilemonth", "relation": "calls", "confidence": "EXTRACTED", "confidenc