rules_version = '2';
// ═══════════════════════════════════════════════════════════
// REGLAS DE FIRESTORE DE OFFICE TRACKER (se publican a mano en la consola de Firebase; ver docs/FIREBASE.md A5)
// 1. Solo el dueño: además de iniciar sesión, el uid debe tener un documento en la colección `duenos`
//    (lo creas tú en la consola; nadie puede crearlo desde la app). Así una cuenta cualquiera de Google
//    no puede usar la cuota del proyecto, y tu uid no queda escrito en el repositorio público.
// 2. Solo la forma que la app escribe: days, log y hidden con campos conocidos y textos cortos.
// ═══════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {
    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/duenos/$(request.auth.uid));
    }
    function texto(d, k, n) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= n); }
    function idOk(id) { return id.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$'); }
    function estado(d, k) { return !(k in d) || d[k] == null || d[k] in ['office', 'vacation']; }

    match /users/{uid}/days/{dia} {
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && dia.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['type', 'ts', 'dev'])
        && estado(request.resource.data, 'type') && request.resource.data.ts is number
        && texto(request.resource.data, 'dev', 16);
    }
    match /users/{uid}/log/{id} {
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && idOk(id) && logOk(request.resource.data, id);
    }
    match /users/{uid}/hidden/{id} {
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && idOk(id)
        && request.resource.data.keys().hasOnly(['ts', 'dev'])
        && request.resource.data.ts is number && texto(request.resource.data, 'dev', 16);
    }
    function logOk(d, id) {
      return d.keys().hasOnly(['id', 'ts', 'd', 'from', 'to', 'src', 'dev', 'slot', 'ok', 'ref', 'note'])
        && d.id == id && d.ts is number && d.d is string && d.d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.src in ['manual', 'undo', 'calendar', 'notif'] && estado(d, 'from') && estado(d, 'to')
        && texto(d, 'dev', 16) && texto(d, 'slot', 8) && texto(d, 'ok', 8) && texto(d, 'ref', 32) && texto(d, 'note', 32);
    }
  }
}
